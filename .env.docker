APP_NAME="Miftahul Ulum"
APP_ENV=local
APP_KEY=base64:IHbbuR5ePk/VIrEYsXLBq5So9l3ok2Im2yEdWazrQQA=
APP_DEBUG=true
# Ganti dari miftahul_ulumv2.test ke localhost (Docker pakai port, bukan vhost)
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ──────────────────────────────────────────────────────────────────
# WAJIB ganti: host pakai nama container "mysql", bukan 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pesantren_db
DB_USERNAME=root
DB_PASSWORD=rootsecret

# ─── Session ───────────────────────────────────────────────────────────────────
# Ganti dari database ke redis agar lebih ringan (opsional, boleh tetap database)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Broadcast ─────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# ─── Queue ─────────────────────────────────────────────────────────────────────
# Ganti dari database ke redis agar queue:work bisa pakai Redis
QUEUE_CONNECTION=redis

# ─── Cache ─────────────────────────────────────────────────────────────────────
# Ganti dari database ke redis
CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

# ─── Redis ─────────────────────────────────────────────────────────────────────
# WAJIB ganti: host pakai nama container "redis", bukan 127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Reverb ────────────────────────────────────────────────────────────────────
REVERB_APP_ID=878288
REVERB_APP_KEY=5e3xxduirsctb4kkd899
REVERB_APP_SECRET=lxrjkddibxcy8fypfb5g
# Internal (antar container): pakai nama container "reverb"
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

# Eksternal (browser / Flutter): pakai localhost
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
